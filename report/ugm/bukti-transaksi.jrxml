			<textField>
				<reportElement x="20" y="431" width="545" height="22" uuid="61933d00-6a55-454b-85c7-2aa9914b6944"/>
				<textElement>
					<font fontName="Montserrat" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Pihak Kedua Membeli Barang Jaminan Kepada Pihak Pertama Dalam Jangka Waktu Selama " + "yang tepatnya jatuh tempo pada tanggal " + $F{jatuh_tempo}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="10" y="453" width="10" height="18" uuid="ff8c9e6a-e3c7-466d-8ac5-2d7c1facdb4a"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Montserrat" size="8"/>
				</textElement>
				<text><![CDATA[2.]]></text>
			</staticText>
			<textField>
				<reportElement x="20" y="453" width="545" height="22" uuid="2881a23b-a133-424c-9388-1a42eb8ceb1a">
					<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Montserrat" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Pinjaman tidak dikenakan bunga berjalan akan tetapi pihak mengambil keuntungan jual kembali kepada pihak pertama dengan jumlah total yang harus dikembalikan sejumlah Rp" + new java.text.DecimalFormat("#,##0").format($F{nominal})]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="10" y="475" width="10" height="18" uuid="bcdd48f0-4bc8-46ff-9745-3bacf3578022"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Montserrat" size="8"/>
				</textElement>
				<text><![CDATA[3.]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="475" width="545" height="30" uuid="532c4e4b-2357-49bb-ab8c-fcb4efa8262b"/>
				<textElement>
					<font fontName="Montserrat" size="8"/>
				</textElement>
				<text><![CDATA[Pada tanggal jatuh tempo jika pihak pertama tidak dapat menebus atau membeli barang jaminannya maka, pihak pertama secara sadar menyetujui barang jaminannya dijual oleh pihak kedua guna melaksanakan kewajiban melunasi pinjamannya dengan ketentuan :]]></text>
			</staticText>
			<staticText>
				<reportElement x="27" y="505" width="20" height="18" uuid="8b2019c9-a5bd-40ba-ab1a-d2167c7c2062"/>
				<textElement>
					<font fontName="Montserrat" size="8"/>
				</textElement>
				<text><![CDATA[a)]]></text>
			</staticText>
			<staticText>
				<reportElement x="47" y="505" width="515" height="21" uuid="5ed0e547-313c-4e25-ad6a-97b0407c1ea5"/>
				<textElement>
					<font fontName="Montserrat" size="8"/>
				</textElement>
				<text><![CDATA[Jika harga barang jaminan terjual melebihi pinjaman, maka uang yang berlebih akan dikembalikan kepada pihak pertama sejumlah 10%]]></text>
			</staticText>
			<staticText>
				<reportElement x="47" y="526" width="515" height="21" uuid="78139622-0146-4669-950b-420045b44ee3"/>
				<textElement>
					<font fontName="Montserrat" size="8"/>
				</textElement>
				<text><![CDATA[Namun jika harga barang jaminan terjual kurang dari jumlah pinjaman maka pihak pertama wajib menambah kekurangan sesuai jumlah pinjaman]]></text>
			</staticText>
