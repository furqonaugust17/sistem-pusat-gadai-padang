				</textElement>
				<text><![CDATA[SYARAT & KETENTUAN]]></text>
			</staticText>
			<staticText>
				<reportElement x="10" y="431" width="10" height="18" uuid="eae716b7-6298-4b52-85d1-63430ab9d88d"/>
				<textElement verticalAlignment="Middle">
